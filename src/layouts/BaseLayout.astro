---
// ============================================================
// BaseLayout — har page ka chrome. Scalable pattern:
//  - <slot name="head" /> = WordPress-style head injection
//    (JSON-LD, meta, analytics/ads scripts) per page
//  - <slot /> = page body
//  - Design tokens global.css se — theming ek jagah
// ============================================================
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'mapsnearme — India ka premium local business directory. Verified businesses, precise mapping, direct connectivity.',
  canonical,
  noindex,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="google-site-verification" content="GlkDu5ZL-CyyKjwPSj9d9X3Y2qsHUj_qAwRwxiLr7nI" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📍</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,600;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="inner container">
        <a class="brand" href="/"><span class="mark">M</span>maps<b>near</b>me</a>
        <nav>
          <a class="link" href="/#top">Home</a>
          <a class="link" href="/#categories">Categories</a>
          <a class="link" href="/#cities">Cities</a>
          <a class="btn btn-ghost" href="/dashboard">Login</a>
          <a class="btn btn-gold" href="/dashboard/list">+ List Business</a>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="foot-grid">
          <div>
            <a class="brand" href="/"><span class="mark">M</span>maps<b>near</b>me</a>
            <p class="muted" style="margin: 14px 0 0; max-width: 34ch; font-size: 0.92rem;">
              India's premium local business directory. Verified businesses with precise mapping and direct connectivity.
            </p>
            <p class="muted" style="font-size: 0.82rem; margin-top: 14px;">Made with ❤️ in India</p>
          </div>
          <div>
            <h4>Explore</h4>
            <a href="/#featured">Featured Listings</a>
            <a href="/#categories">Categories</a>
            <a href="/#cities">Cities</a>
          </div>
          <div>
            <h4>Business</h4>
            <a href="/dashboard/list">List Your Business</a>
            <a href="/dashboard">Dashboard Login</a>
          </div>
          <div>
            <h4>Support</h4>
            <a href="/dashboard/advertise">Advertise with Us</a>
            <a href="/dashboard/support">Contact Support</a>
          </div>
        </div>
        <div class="foot-bottom">
          <span>© {new Date().getFullYear()} mapsnearme — India business directory</span>
          <span>Growing across India 🇮🇳</span>
        </div>
      </div>
    </footer>
  </body>
</html>
