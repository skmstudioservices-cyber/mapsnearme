---
// BizCard — premium business card (VERIFIED tag, gold rating, cover block)
import type { Business } from '../lib/data';

interface Props {
  biz: Business;
}
const { biz } = Astro.props;
const city = biz.city?.name;
const cat = biz.category?.name;
const rating = typeof biz.avg_rating === 'number' && biz.avg_rating > 0 ? biz.avg_rating.toFixed(1) : null;
---

<a class="card biz-card" href={`/b/${biz.id}`}>
  <div class="biz-cover">{biz.logo_url ? <img src={biz.logo_url} alt="" loading="lazy" /> : <span>📍</span>}</div>
  <div class="biz-body">
    <span class="biz-tag">{biz.is_verified ? 'Verified Business' : 'Listing'}</span>
    <h3>{biz.name}</h3>
    <div class="biz-meta">
      {rating && (
        <>
          <span class="biz-rating">★ {rating}</span>
          {biz.review_count != null && <span>({biz.review_count})</span>}
        </>
      )}
      {cat && <span>·</span>}
      {cat && <span>{cat}</span>}
      {city && <span>·</span>}
      {city && <span>{city}</span>}
    </div>
    {biz.tagline && <div class="muted" style="font-size: 0.86rem">{biz.tagline}</div>}
  </div>
</a>
