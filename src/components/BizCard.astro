---
// BizCard — reusable business card component.
// Grid me kahin bhi use hota hai (home, city, category, search results).
import type { Business } from '../lib/data';

interface Props {
  biz: Business;
}
const { biz } = Astro.props;
---

<article class="card biz-card">
  <div class="row">
    <div>
      <h3><a href={`/b/${biz.id}`}>{biz.name}</a></h3>
      {biz.category?.name && <div class="muted">{biz.category.name}{biz.city ? ` · ${biz.city.name}` : ''}</div>}
      {biz.tagline && <div class="muted">{biz.tagline}</div>}
      {biz.address && <div class="muted">📍 {biz.address}</div>}
    </div>
    {typeof biz.avg_rating === 'number' && biz.avg_rating > 0 && (
      <div class="rating">★ {Number(biz.avg_rating).toFixed(1)}</div>
    )}
  </div>
  <div style="display:flex; gap:6px; margin-top:10px; flex-wrap:wrap;">
    {biz.is_verified && <span class="badge">✔ Verified</span>}
    {biz.is_featured && <span class="badge feat">★ Featured</span>}
    {biz.phone && <a class="btn btn-ghost" href={`tel:${biz.phone}`}>📞 Call</a>}
    {biz.whatsapp && (
      <a class="btn btn-ghost" href={`https://wa.me/${biz.whatsapp.replace(/\D/g, '')}`} target="_blank" rel="noopener">WhatsApp</a>
    )}
  </div>
</article>
