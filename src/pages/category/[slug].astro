---
// /category/[slug] — category page: businesses across all cities (pSEO template)
// Phase 4: BreadcrumbList + ItemList JSON-LD, city-combo internal links, ad slot.
import BaseLayout from '../../layouts/BaseLayout.astro';
import BizCard from '../../components/BizCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import { getCategoryBySlug, getBusinesses, getCities } from '../../lib/data';

const { slug } = Astro.params;
const category = await getCategoryBySlug(Astro, slug ?? '');
if (!category) {
  return Astro.redirect('/?notfound=category');
}
const [businesses, cities] = await Promise.all([
  getBusinesses(Astro, { categorySlug: slug, limit: 48 }),
  getCities(Astro),
]);

const BASE = 'https://mapsnearme.pages.dev';
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${BASE}/` },
        { '@type': 'ListItem', position: 2, name: category.name, item: `${BASE}/category/${category.slug}` },
      ],
    },
    {
      '@type': 'ItemList',
      itemListElement: businesses.slice(0, 20).map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.name,
        url: `${BASE}/b/${b.id}`,
      })),
    },
  ],
});
---

<BaseLayout
  title={`${category.name} in India — Directory of ${category.name} Near You | mapsnearme`}
  description={`Best ${category.name.toLowerCase()} in India — verified listings with ratings, phone numbers, addresses and maps. Find ${category.name.toLowerCase()} near you.`}
  canonical={`https://mapsnearme.pages.dev/category/${category.slug}`}
>
  <script slot="head" type="application/ld+json" set:html={jsonLd} />

  <section class="section">
    <h1 style="margin:16px 0 4px;">{category.icon ?? ''} {category.name} in India</h1>
    <AdSlot slot="category-top" />
    {businesses.length > 0 ? (
      <div class="grid grid-biz">
        {businesses.map((b) => <BizCard biz={b} />)}
      </div>
    ) : (
      <div class="empty">Is category mein abhi listings nahi hain.</div>
    )}

    {cities.length > 0 && (
      <div class="card pad" style="margin-top: 48px;">
        <h3 style="margin: 0 0 4px; font-size: 1.1rem;">{category.name} by City</h3>
        <p class="muted" style="margin: 0; font-size: 0.9rem;">
          Browse {category.name.toLowerCase()} in your city:
        </p>
        <div style="display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px;">
          {cities.map((c) => (
            <a
              class="btn btn-ghost"
              href={`/search?q=${encodeURIComponent(category.name)}&loc=${encodeURIComponent(c.name)}`}
            >
              {category.name} in {c.name}
            </a>
          ))}
        </div>
      </div>
    )}
  </section>
</BaseLayout>
