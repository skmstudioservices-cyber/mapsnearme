---
// /privacy — Privacy Policy (WS3 — DPDP Act 2023 & AdSense ready)
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Privacy Policy — mapsnearme"
  description="Privacy policy of mapsnearme business directory in compliance with India's Digital Personal Data Protection Act (DPDP) 2023."
  canonical="https://mapsnearme.pages.dev/privacy"
>
  <section class="section" style="max-width: 800px; margin: 0 auto; padding-top: 48px;">
    <p class="eyebrow">Legal & Compliance</p>
    <h1 style="font-size: clamp(2rem, 5vw, 3rem); margin: 8px 0 24px; font-weight: 800;">
      Privacy <span style="color: var(--gold);">Policy</span>
    </h1>

    <div class="card pad" style="margin-bottom: 28px; line-height: 1.8;">
      <p><strong>Effective Date:</strong> September 2026</p>
      <p>
        At <strong>mapsnearme</strong>, accessible via <a href="https://mapsnearme.pages.dev" style="color: var(--gold);">mapsnearme.pages.dev</a>, we are committed to respecting your privacy in adherence to India's <strong>Digital Personal Data Protection Act, 2023 (DPDP Act)</strong> and international standard privacy practices.
      </p>

      <h2 style="font-size: 1.3rem; margin-top: 24px; color: var(--gold);">1. Information We Collect</h2>
      <p>
        As a general visitor browsing directory listings, you can use mapsnearme without creating an account or providing direct personal identifying details.
      </p>
      <ul style="color: var(--muted); padding-left: 20px;">
        <li><strong>Geolocation Data:</strong> If you use the "Near Me" feature, your browser requests permission to access your coordinates. These coordinates are processed ephemerally on the server to query nearby listings and are not stored in our databases.</li>
        <li><strong>Business Listing Information:</strong> Contact details, addresses, and trade names are sourced either from publicly available public directories or directly submitted by authorized representatives.</li>
      </ul>

      <h2 style="font-size: 1.3rem; margin-top: 24px; color: var(--gold);">2. Cookies & Analytics</h2>
      <p>
        We utilize lightweight, privacy-focused analytics tools (such as Cloudflare Web Analytics) which do not use intrusive tracking cookies or fingerprint individual browsing across the web.
      </p>

      <h2 style="font-size: 1.3rem; margin-top: 24px; color: var(--gold);">3. Third-Party Advertising & Partners</h2>
      <p>
        We may display advertisements through certified partners (such as Google AdSense). Third-party vendors, including Google, use cookies to serve ads based on prior visits to this or other websites. You may opt out of personalized advertising by visiting Google Ads Settings.
      </p>

      <h2 style="font-size: 1.3rem; margin-top: 24px; color: var(--gold);">4. Data Subject Rights</h2>
      <p>
        In line with the DPDP Act 2023, you have the right to request access to, correction of, or removal of your business listing information. To exercise your rights or request updates, please email us at <a href="mailto:skmstudio.services@gmail.com" style="color: var(--gold);">skmstudio.services@gmail.com</a>.
      </p>
    </div>
  </section>
</BaseLayout>
