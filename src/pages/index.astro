---
// Homepage — hero + search + cities + categories (data layer se)
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCities, getCategories, dataReady } from '../lib/data';

const ready = dataReady(Astro);
const [cities, categories] = ready ? await Promise.all([getCities(Astro), getCategories(Astro)]) : [[], []];
---

<BaseLayout
  title="mapsnearme — India Local Business Directory | Find Businesses Near Me"
  description="India ka local business directory — dentists, restaurants, hospitals, hotels sab near you. Free listings, verified businesses."
  canonical="https://mapsnearme.pages.dev/"
>
  <section class="hero">
    <h1>Find businesses <span style="color:var(--primary)">near you</span></h1>
    <p>India ka local search — {cities.length > 0 ? `${cities.length}+ cities` : 'cities'} · {categories.length > 0 ? `${categories.length}+ categories` : 'categories'} · free</p>
    <form class="search-form" action="/search" method="get">
      <input type="search" name="q" placeholder="Dentist, restaurant, hospital..." aria-label="Search" />
      <button class="btn" type="submit">Search</button>
    </form>
  </section>

  <section class="section">
    <h2>Popular categories</h2>
    {categories.length > 0 ? (
      <div class="grid grid-cats">
        {categories.slice(0, 16).map((c) => (
          <a class="card cat-tile" href={`/category/${c.slug}`}>
            <span class="icon">{c.icon ?? '📁'}</span>
            <strong>{c.name}</strong>
          </a>
        ))}
      </div>
    ) : (
      <div class="empty">
        Categories setup ho rahi hain.<br />
        <span class="muted">(SUPABASE_URL + SUPABASE_ANON_KEY env vars set karo — CF Pages → Settings → Environment variables)</span>
      </div>
    )}
  </section>

  <section class="section">
    <h2>Cities</h2>
    {cities.length > 0 ? (
      <div class="grid grid-cities">
        {cities.slice(0, 32).map((c) => (
          <a class="card" href={`/city/${c.slug}`}><strong>{c.name}</strong>{c.state ? <div class="muted">{c.state}</div> : null}</a>
        ))}
      </div>
    ) : (
      <div class="empty">Cities setup ho rahi hain.</div>
    )}
  </section>
</BaseLayout>
